{
  "family": "kitex-shop-api",
  "containerDefinitions": [
    {
      "name": "kitex-shop-api",
      "image": "236763663116.dkr.ecr.us-west-1.amazonaws.com/kitex-shop-api:latest",
      "cpu": 0,
      "portMappings": [
        {
          "name": "api-http",
          "containerPort": 8889,
          "hostPort": 8889,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/kitex-shop-api-service",
          "awslogs-region": "us-west-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "systemControls": []
    }
  ],
  "executionRoleArn": "arn:aws:iam::236763663116:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048"
}
